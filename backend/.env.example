# Database configuration (SQLite for local MVP, PostgreSQL ready)
DATABASE_URL=sqlite:///./livelihood.db

# Groq Cloud API Key (Recommended - Free, high-speed LLaMA 3.3 for conversational voice assistant)
# Obtain your free key from: https://console.groq.com
GROQ_API_KEY=

# Optional alternative LLM keys
GEMINI_API_KEY=
OPENAI_API_KEY=
